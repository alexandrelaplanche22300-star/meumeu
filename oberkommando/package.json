{
  "name": "oberkommando-der-meumeu",
  "productName": "Oberkommando der Meumeu",
  "version": "1.0.0",
  "description": "Oberkommando der Meumeu — gestion et guerre totale chez les peluches",
  "author": "Meumeu",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.meumeu.oberkommando",
    "productName": "Oberkommando der Meumeu",
    "directories": { "output": "release" },
    "files": ["electron/**", "package.json"],
    "extraResources": [{ "from": "jeu", "to": "jeu", "filter": ["**/*", "!test/**"] }],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "icon": "electron/icon.png" },
    "portable": { "artifactName": "OberkommandoDerMeumeu.exe" }
  }
}
